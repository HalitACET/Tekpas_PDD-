# Bu dosyayi .env olarak kopyala. .env ASLA commit edilmez.
# Prod degerleri Render / Vercel / GitHub Secrets'ta tutulur.

# --- Backend ---
SPRING_PROFILES_ACTIVE=local,demo
# Prod (Neon): jdbc:postgresql://<dogrudan-host>/<db>?sslmode=require  (pooler degil, K19; bkz. docs/DEPLOY.md)
DATABASE_URL=jdbc:postgresql://localhost:5433/tekpas
DATABASE_USERNAME=tekpas
DATABASE_PASSWORD=tekpas

JWT_SECRET=degistir-en-az-32-karakterlik-rastgele-bir-deger
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Local: MinIO. Prod: Supabase Storage S3 endpoint
# (https://<proje-ref>.storage.supabase.co/storage/v1/s3, S3_REGION = proje bolgesi)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=tekpas
S3_SECRET_KEY=tekpas-secret
S3_BUCKET=tekpas-docs

GEMINI_API_KEY=
# Model ID'si sik degisir: gelistirme gunu AI Studio'dan kontrol et
GEMINI_MODEL=

# Demo kullanicilarinin ortak sifresi (sadece demo profili). Bossa demo verisi yuklenmez.
DEMO_PASSWORD=

# QR / GS1 Digital Link kok adresi (K13). Prod: https://kozapass.vercel.app (M6'da Render env'e eklenecek).
PUBLIC_BASE_URL=http://localhost:3000
# Opsiyonel. Web kendi origin'i uzerinden eristigi icin (K18) gerekmez; bossa CORS kapali.
CORS_ALLOWED_ORIGINS=

# --- Web ---
# Sunucu tarafi: /api/v1/* istekleri buraya proxy edilir (K18), health rozeti de buradan okur.
# Tarayici API'ye her zaman kendi origin'i uzerinden gider.
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Mobil ---
EXPO_PUBLIC_API_URL=http://192.168.1.X:8080/api/v1
