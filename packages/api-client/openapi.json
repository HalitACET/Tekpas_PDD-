{
  "components" : {
    "schemas" : {
      "ApiProblem" : {
        "description" : "RFC 7807 problem detail",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "description" : "Only for type urn:tekpas:problem:validation",
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "example" : 400,
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "example" : "Validation failed",
            "type" : "string"
          },
          "type" : {
            "example" : "urn:tekpas:problem:validation",
            "type" : "string"
          }
        },
        "required" : [ "status", "title", "type" ]
      },
      "CompanySummary" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "type" : {
            "enum" : [ "MANUFACTURER", "YARN", "FABRIC", "DYEHOUSE", "SEWING", "ACCESSORY", "OTHER" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FieldViolation" : {
        "description" : "Only for type urn:tekpas:problem:validation",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        }
      },
      "LoginRequest" : {
        "properties" : {
          "client" : {
            "enum" : [ "WEB", "MOBILE" ],
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "client", "email", "password" ],
        "type" : "object"
      },
      "LoginResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserSummary"
          }
        },
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "company" : {
            "$ref" : "#/components/schemas/CompanySummary"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "locale" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "OWNER", "ADMIN", "EDITOR", "SUPPLIER", "VIEWER" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "TokenResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "UserSummary" : {
        "properties" : {
          "company" : {
            "$ref" : "#/components/schemas/CompanySummary"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "locale" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "OWNER", "ADMIN", "EDITOR", "SUPPLIER", "VIEWER" ],
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Digital Product Passport platform for textile manufacturers",
    "title" : "TekPas API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "WEB clients receive the refresh token as an httpOnly cookie, MOBILE clients in the body.",
        "operationId" : "login",
        "parameters" : [ {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            },
            "description" : "Logged in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Validation failed"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Invalid credentials"
          }
        },
        "security" : [ ],
        "summary" : "Log in with e-mail and password",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "description" : "Authenticated by the refresh token itself. Always 204, also for missing or unknown tokens.",
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "tekpas_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "Logged out"
          }
        },
        "security" : [ ],
        "summary" : "Log out: revoke the refresh token family and clear the cookie",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "Current user"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Missing or invalid access token"
          }
        },
        "summary" : "The current user with company and role",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Reads the refresh token from the cookie (WEB) or the body (MOBILE). A reused token revokes its whole family.",
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "tekpas_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Tokens rotated"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Missing, expired, reused or revoked refresh token"
          }
        },
        "security" : [ ],
        "summary" : "Rotate the refresh token and issue a new access token",
        "tags" : [ "auth" ]
      }
    }
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Login, token refresh, logout and the current user",
    "name" : "auth"
  } ]
}
