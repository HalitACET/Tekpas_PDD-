{
  "components" : {
    "schemas" : {
      "ApiProblem" : {
        "description" : "RFC 7807 problem detail",
        "properties" : {
          "detail" : {
            "type" : [ "string", "null" ]
          },
          "errors" : {
            "description" : "Field errors: type urn:tekpas:problem:validation, or conflict on a unique field (code Unique)",
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            },
            "type" : [ "array", "null" ]
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "reason" : {
            "description" : "Conflicts that are not about one field, e.g. PRODUCT_HAS_BATCHES, GTIN_LOCKED",
            "example" : "PRODUCT_HAS_BATCHES",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "example" : 400,
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "example" : "Validation failed",
            "type" : "string"
          },
          "type" : {
            "example" : "urn:tekpas:problem:validation",
            "type" : "string"
          }
        },
        "required" : [ "status", "title", "type" ]
      },
      "BatchCreateRequest" : {
        "properties" : {
          "batchNo" : {
            "example" : "KP-2026-1003-A",
            "pattern" : "^[A-Z0-9-]{0,20}$",
            "type" : [ "string", "null" ]
          },
          "producedFrom" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "producedTo" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "productId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "productionOrderNo" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "quantity" : {
            "exclusiveMinimum" : 0,
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "productId", "quantity" ],
        "type" : "object"
      },
      "BatchProduct" : {
        "properties" : {
          "gtin" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "gtin", "id", "name" ],
        "type" : "object"
      },
      "BatchResponse" : {
        "properties" : {
          "batchNo" : {
            "type" : "string"
          },
          "chain" : {
            "$ref" : "#/components/schemas/ChainSummary"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "producedFrom" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "producedTo" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "product" : {
            "$ref" : "#/components/schemas/BatchProduct"
          },
          "productionOrderNo" : {
            "type" : [ "string", "null" ]
          },
          "quantity" : {
            "format" : "int32",
            "type" : "integer"
          },
          "status" : {
            "$ref" : "#/components/schemas/BatchStatus"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "batchNo", "chain", "createdAt", "id", "product", "quantity", "status", "updatedAt" ],
        "type" : "object"
      },
      "BatchStatus" : {
        "enum" : [ "DRAFT", "COLLECTING", "READY", "PUBLISHED" ],
        "type" : "string"
      },
      "BatchUpdateRequest" : {
        "properties" : {
          "batchNo" : {
            "type" : [ "string", "null" ]
          },
          "producedFrom" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "producedTo" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "productionOrderNo" : {
            "type" : [ "string", "null" ]
          },
          "quantity" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          }
        },
        "type" : "object"
      },
      "ChainSummary" : {
        "properties" : {
          "approvedSteps" : {
            "format" : "int32",
            "type" : "integer"
          },
          "totalSteps" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "approvedSteps", "totalSteps" ],
        "type" : "object"
      },
      "CompanySummary" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "type" : {
            "enum" : [ "MANUFACTURER", "YARN", "FABRIC", "DYEHOUSE", "SEWING", "ACCESSORY", "OTHER" ],
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "type" ],
        "type" : "object"
      },
      "Fiber" : {
        "enum" : [ "COTTON", "ORGANIC_COTTON", "ELASTANE", "POLYESTER", "RECYCLED_POLYESTER", "LINEN", "WOOL", "VISCOSE", "POLYAMIDE", "LYOCELL", "RECYCLED_COTTON", "SILK", "OTHER" ],
        "type" : "string"
      },
      "FiberShare" : {
        "properties" : {
          "fiber" : {
            "$ref" : "#/components/schemas/Fiber"
          },
          "percent" : {
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "fiber", "percent" ],
        "type" : "object"
      },
      "FieldViolation" : {
        "description" : "Field errors: type urn:tekpas:problem:validation, or conflict on a unique field (code Unique)",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : [ "string", "null" ]
          },
          "params" : {
            "additionalProperties" : {
              "type" : "object"
            },
            "type" : [ "object", "null" ]
          }
        },
        "required" : [ "code", "field" ]
      },
      "LoginRequest" : {
        "properties" : {
          "client" : {
            "enum" : [ "WEB", "MOBILE" ],
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "rememberMe" : {
            "type" : [ "boolean", "null" ]
          }
        },
        "required" : [ "client", "email", "password" ],
        "type" : "object"
      },
      "LoginResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : [ "string", "null" ]
          },
          "tokenType" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserSummary"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType", "user" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "company" : {
            "$ref" : "#/components/schemas/CompanySummary"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "locale" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "OWNER", "ADMIN", "EDITOR", "SUPPLIER", "VIEWER" ],
            "type" : "string"
          }
        },
        "required" : [ "company", "email", "fullName", "id", "locale", "role" ],
        "type" : "object"
      },
      "NextBatchNoResponse" : {
        "properties" : {
          "batchNo" : {
            "type" : "string"
          }
        },
        "required" : [ "batchNo" ],
        "type" : "object"
      },
      "PageResponseBatchResponse" : {
        "properties" : {
          "content" : {
            "items" : {
              "$ref" : "#/components/schemas/BatchResponse"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "totalElements" : {
            "format" : "int64",
            "type" : "integer"
          },
          "totalPages" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "content", "page", "size", "totalElements", "totalPages" ],
        "type" : "object"
      },
      "PageResponseProductListItem" : {
        "properties" : {
          "content" : {
            "items" : {
              "$ref" : "#/components/schemas/ProductListItem"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "totalElements" : {
            "format" : "int64",
            "type" : "integer"
          },
          "totalPages" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "content", "page", "size", "totalElements", "totalPages" ],
        "type" : "object"
      },
      "ProductCategory" : {
        "enum" : [ "T_SHIRT", "SHIRT", "TROUSERS", "DRESS", "KNITWEAR", "SWEATSHIRT", "OUTERWEAR", "BABY", "HOME_TEXTILE", "FABRIC", "OTHER" ],
        "type" : "string"
      },
      "ProductCreateRequest" : {
        "properties" : {
          "category" : {
            "$ref" : "#/components/schemas/ProductCategory"
          },
          "declaredFiberComposition" : {
            "items" : {
              "$ref" : "#/components/schemas/FiberShare"
            },
            "type" : [ "array", "null" ]
          },
          "description" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "gtin" : {
            "example" : "02012345000018",
            "type" : "string"
          },
          "name" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "sku" : {
            "maxLength" : 60,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "category", "gtin", "name" ],
        "type" : "object"
      },
      "ProductListItem" : {
        "properties" : {
          "batchCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "category" : {
            "$ref" : "#/components/schemas/ProductCategory"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "declaredFiberComposition" : {
            "items" : {
              "$ref" : "#/components/schemas/FiberShare"
            },
            "type" : [ "array", "null" ]
          },
          "gtin" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "sku" : {
            "type" : [ "string", "null" ]
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "batchCount", "category", "createdAt", "gtin", "id", "name", "updatedAt" ],
        "type" : "object"
      },
      "ProductResponse" : {
        "properties" : {
          "batchCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "category" : {
            "$ref" : "#/components/schemas/ProductCategory"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "declaredFiberComposition" : {
            "items" : {
              "$ref" : "#/components/schemas/FiberShare"
            },
            "type" : [ "array", "null" ]
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "gtin" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "sku" : {
            "type" : [ "string", "null" ]
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "batchCount", "category", "createdAt", "gtin", "id", "name", "updatedAt" ],
        "type" : "object"
      },
      "ProductUpdateRequest" : {
        "properties" : {
          "category" : {
            "$ref" : "#/components/schemas/ProductCategory"
          },
          "declaredFiberComposition" : {
            "items" : {
              "$ref" : "#/components/schemas/FiberShare"
            },
            "type" : [ "array", "null" ]
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "gtin" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "sku" : {
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "type" : "string"
          }
        },
        "required" : [ "refreshToken" ],
        "type" : "object"
      },
      "TokenResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : [ "string", "null" ]
          },
          "tokenType" : {
            "type" : "string"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType" ],
        "type" : "object"
      },
      "UserSummary" : {
        "properties" : {
          "company" : {
            "$ref" : "#/components/schemas/CompanySummary"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "locale" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "OWNER", "ADMIN", "EDITOR", "SUPPLIER", "VIEWER" ],
            "type" : "string"
          }
        },
        "required" : [ "company", "email", "fullName", "id", "locale", "role" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Digital Product Passport platform for textile manufacturers",
    "title" : "KozaPass API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "WEB clients receive the refresh token as an httpOnly cookie, MOBILE clients in the body. With rememberMe=false the WEB cookie is a session cookie (no Max-Age).",
        "operationId" : "login",
        "parameters" : [ {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            },
            "description" : "Logged in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Validation failed"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Invalid credentials"
          }
        },
        "security" : [ ],
        "summary" : "Log in with e-mail and password",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "description" : "Authenticated by the refresh token itself. Always 204, also for missing or unknown tokens.",
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "tekpas_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "Logged out"
          }
        },
        "security" : [ ],
        "summary" : "Log out: revoke the refresh token family and clear the cookie",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "Current user"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Missing or invalid access token"
          }
        },
        "summary" : "The current user with company and role",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Reads the refresh token from the cookie (WEB) or the body (MOBILE). A reused token revokes its whole family.",
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "tekpas_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "cookie",
          "name" : "tekpas_rt_mode",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Tokens rotated"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Missing, expired, reused or revoked refresh token"
          }
        },
        "security" : [ ],
        "summary" : "Rotate the refresh token and issue a new access token",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/batches" : {
      "get" : {
        "operationId" : "listBatches",
        "parameters" : [ {
          "description" : "Search in batch no, production order no, product name and GTIN",
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "productId",
          "required" : false,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "$ref" : "#/components/schemas/BatchStatus"
          }
        }, {
          "description" : "Zero-based page",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        }, {
          "description" : "batchNo | productName | quantity | producedFrom | createdAt | updatedAt, optionally ,asc or ,desc (default createdAt,desc)",
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseBatchResponse"
                }
              }
            },
            "description" : "One page of batches"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Invalid paging or sort parameter"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "Supplier users have no access"
          }
        },
        "summary" : "List batches with product and supply chain progress",
        "tags" : [ "batches" ]
      },
      "post" : {
        "description" : "Without batchNo the next KP-YYYY-MMDD-<letter> number of the day is assigned.",
        "operationId" : "createBatch",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BatchCreateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
